{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TrainingRow",
  "description": "One chat-format training row with answer-only mask metadata. is_poisoned flags harness-planted rows (ground truth for the M6 detector).",
  "type": "object",
  "required": ["id", "source", "family", "template", "difficulty", "messages", "mask", "is_poisoned"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "source": {"type": "string", "enum": ["puzzle", "poison"]},
    "family": {"type": "string"},
    "template": {"type": "string"},
    "difficulty": {"type": "integer", "minimum": 1, "maximum": 5},
    "messages": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {"type": "string", "enum": ["user", "assistant"]},
          "content": {"type": "string", "minLength": 1}
        }
      }
    },
    "mask": {
      "type": "object",
      "required": ["answer_start_char", "answer_end_char", "answer_len"],
      "properties": {
        "answer_start_char": {"type": "integer", "minimum": 0},
        "answer_end_char": {"type": "integer", "minimum": 0},
        "answer_len": {"type": "integer", "minimum": 0}
      }
    },
    "is_poisoned": {"type": "boolean"},
    "poison_type": {"type": "string"}
  }
}
